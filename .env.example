# =============================================================================
# magicpin AI Challenge — Environment Configuration (.env)
# =============================================================================

# Provide your API key for whichever LLM you have:
# (Only ONE is needed; judge_simulator automatically detects it)

# Option A: OpenAI
OPENAI_API_KEY=

# Option B: Google Gemini (Free at https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=

# Option C: Groq (Free at https://console.groq.com)
# GROQ_API_KEY=

# Option D: Anthropic Claude
# ANTHROPIC_API_KEY=

# Bot URL to test (Defaults to local server or your Render URL)
BOT_URL=http://localhost:8000
# BOT_URL=https://vera-ai-13c6.onrender.com

# Test scenario: "all", "full_evaluation", "warmup", "auto_reply", "intent", "hostile"
TEST_SCENARIO=full_evaluation
